<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.GM.mapper.ShoppingCartMapper">


    <!-- 条件查询：按非空字段动态拼接（userId / dishId / setmealId / dishFlavor） -->
    <select id="list" parameterType="com.GM.entity.ShoppingCart" resultType="com.GM.entity.ShoppingCart">
        SELECT * FROM shopping_cart
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="dishId != null">
                AND dish_id = #{dishId}
            </if>
            <if test="setmealId != null">
                AND setmeal_id = #{setmealId}
            </if>
            <if test="dishFlavor != null">
                AND dish_flavor = #{dishFlavor}
            </if>
        </where>
    </select>

    <!-- 按 ID 更新数量 -->
    <update id="updateNumberById" parameterType="com.GM.entity.ShoppingCart">
        UPDATE shopping_cart SET number = #{number} WHERE id = #{id}
    </update>

    <!-- 新增购物车记录 -->
    <insert id="insert" parameterType="com.GM.entity.ShoppingCart" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO shopping_cart (name, image, user_id, dish_id, setmeal_id, dish_flavor, number, amount, create_time)
        VALUES (#{name}, #{image}, #{userId}, #{dishId}, #{setmealId}, #{dishFlavor}, #{number}, #{amount}, #{createTime})
    </insert>

    <!-- 按 ID 删除购物车记录 -->
    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM shopping_cart WHERE id = #{id}
    </delete>
    <!-- 按用户 ID 清空该用户的购物车记录 -->
    <delete id="deleteByUserId" parameterType="java.lang.Long">
        DELETE FROM shopping_cart WHERE user_id = #{userId}
    </delete>
    
</mapper>